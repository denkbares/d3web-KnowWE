<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<artifactId>KnowWE-Plugins</artifactId>
		<groupId>de.uniwue.d3web</groupId>
		<version>${revision}</version>
	</parent>
	<artifactId>KnowWE-Plugin-Search</artifactId>

	<description>
		Abschnittsweise Volltextsuche über das KDOM. Ersetzt den seitenweisen Index von
		JSPWikis LuceneSearchProvider durch ein Lucene-Dokument je Überschriften-Abschnitt
		über bereinigtem Text, und liefert Treffer als gerenderte KnowWE-Preview aus.
		Siehe documentation/Wiki-Search-Plan.md.
	</description>

	<dependencies>
		<!-- KDOM, Sections, ArticleManager, Events -->
		<dependency>
			<groupId>de.uniwue.d3web</groupId>
			<artifactId>KnowWE-core</artifactId>
		</dependency>
		<!-- PreviewManager/PreviewRenderer, RenderPreviewAction, ObjectInfoRenderer -->
		<dependency>
			<groupId>de.uniwue.d3web</groupId>
			<artifactId>KnowWE-Plugin-Core</artifactId>
		</dependency>
		<!-- HeaderType, JSPWikiMarkupUtils, HeaderPreviewRenderer -->
		<dependency>
			<groupId>de.uniwue.d3web</groupId>
			<artifactId>KnowWE-Plugin-JSPWiki-MarkupSet</artifactId>
		</dependency>
		<!-- JSPWiki-SPI, ActionAllowListChecker, JSPWikiConnector -->
		<dependency>
			<groupId>de.uniwue.d3web</groupId>
			<artifactId>KnowWE-Plugin-JSPWiki-Connector</artifactId>
		</dependency>
		<!-- Analyzer-Bausteine, SearcherContext, DisjunctionMaxRewrite, LuceneUtils -->
		<dependency>
			<groupId>com.denkbares</groupId>
			<artifactId>denkbares-LuceneUtils</artifactId>
		</dependency>

		<dependency>
			<groupId>org.apache.lucene</groupId>
			<artifactId>lucene-core</artifactId>
		</dependency>
		<dependency>
			<groupId>org.apache.lucene</groupId>
			<artifactId>lucene-analysis-common</artifactId>
		</dependency>
		<dependency>
			<groupId>org.apache.lucene</groupId>
			<artifactId>lucene-queries</artifactId>
		</dependency>
		<dependency>
			<groupId>org.apache.lucene</groupId>
			<artifactId>lucene-queryparser</artifactId>
		</dependency>
		<dependency>
			<groupId>org.apache.lucene</groupId>
			<artifactId>lucene-highlighter</artifactId>
		</dependency>

		<dependency>
			<groupId>junit</groupId>
			<artifactId>junit</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>
</project>
