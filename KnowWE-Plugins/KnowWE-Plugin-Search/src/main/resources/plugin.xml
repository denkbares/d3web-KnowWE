<plugin id="KnowWE-Plugin-Search" version="1.0">

	<requires>
		<import plugin-id="KnowWEExtensionPoints" />
		<import plugin-id="KnowWE-Plugin-Core" />
	</requires>

	<runtime>
		<library id="de.knowwe" path="." type="code">
			<export prefix="*" />
		</library>
		<library id="webapp" path="webapp/" type="resources">
			<export prefix="*" />
		</library>
	</runtime>

	<!--
		Ausgelieferte Web-Ressourcen muessen mit der Plugin-ID beginnen, sonst verwirft
		KnowWEPlugin.includeDOMResources() sie stillschweigend mit einer ERROR-Zeile.

		Die Extensions folgen mit den jeweiligen Stufen:
		  Stufe 3  EventListener  WikiSearchIndexListener
		           Instantiation  WikiSearchInstantiation
		  Stufe 4  Action         WikiSearchAction
		  Stufe 5  dazu die Parameter script/css fuer KnowWE-Plugin-Search.js/.css
	-->

</plugin>
