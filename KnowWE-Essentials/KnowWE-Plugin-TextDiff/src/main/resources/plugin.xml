<?xml version="1.0" ?>
<!DOCTYPE plugin PUBLIC "-//JPF//Java Plug-in Manifest 1.0"
	"http://jpf.sourceforge.net/plugin_1_0.dtd">
<plugin id="KnowWE-Plugin-TextDiff" version="1.0-SNAPSHOT">

	<requires>
		<import plugin-id="KnowWEExtensionPoints" />
	</requires>

	<runtime>
		<library id="de.knowwe" path="." type="code">
			<export prefix="*" />
		</library>
		<library id="webapp" path="webapp/" type="resources">
			<export prefix="*" />
		</library>
	</runtime>

	<extension plugin-id="KnowWEExtensionPoints" point-id="Instantiation" id="TextDiffResources">
		<parameter id="class" value="com.denkbares.knowwe.textdiff.TextDiffResources" />
		<parameter id="name" value="TextDiffResources" />
		<parameter id="description" value="Registers the script and the stylesheet of the knowwe-text-diff and knowwe-file-change web components." />
		<parameter id="version" value="1.0" />
		<parameter id="priority" value="5" />
	</extension>

</plugin>
