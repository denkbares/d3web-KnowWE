{
  "name": "knowwe-codemirror",
  "version": "1.0.0",
  "private": true,
  "description": "Builds the statically vendored CodeMirror bundle exposed to KnowWE and its plugins as global CodeMirror",
  "type": "module",
  "scripts": {
    "build": "vite build"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.18.6",
    "@codemirror/commands": "6.8.1",
    "@codemirror/language": "6.11.2",
    "@codemirror/lint": "6.8.5",
    "@codemirror/merge": "6.12.2",
    "@codemirror/search": "6.5.11",
    "@codemirror/state": "6.5.2",
    "@codemirror/view": "6.38.1",
    "@lezer/common": "1.2.3",
    "@lezer/highlight": "1.2.1",
    "@lezer/lr": "1.4.10"
  },
  "devDependencies": {
    "vite": "8.3.4"
  },
  "pnpm": {
    "patchedDependencies": {
      "@codemirror/merge@6.12.2": "patches/@codemirror__merge@6.12.2.patch"
    }
